# WARLANDS environment — copy to .env.local and fill in.

# --- Backend (GDD §19/§21). Unset = app runs in client-side mock mode. ---
# Neon Postgres (Vercel Marketplace) connection string:
DATABASE_URL=

# --- Live world server (Railway). Unset = /world tries ws://localhost:8080. ---
# Public WebSocket URL of the authoritative game server (server/), e.g. wss://<svc>.up.railway.app
NEXT_PUBLIC_GAME_SERVER_URL=

# --- On-chain layer (GDD §20). Unset = mocked staking. Deploy contracts/ first. ---
NEXT_PUBLIC_WAR_TOKEN=
NEXT_PUBLIC_STAKING_MANAGER=
NEXT_PUBLIC_SINK_ROUTER=
NEXT_PUBLIC_REWARD_DISTRIBUTOR=
