# WARLANDS environment — copy to .env.local and fill in.

# --- Backend (GDD §19/§21). Unset = app runs in client-side mock mode. ---
# Neon Postgres (Vercel Marketplace) connection string:
DATABASE_URL=

# --- Live world server (Railway). Unset = /world tries ws://localhost:8080. ---
# Public WebSocket URL of the authoritative game server (server/), e.g. wss://<svc>.up.railway.app
NEXT_PUBLIC_GAME_SERVER_URL=
# Server-side (set on the world server, NOT the Next app): require wallet-signature identity.
# AUTH_REQUIRED=1   # mainnet: one wallet = one base (no anonymous play). Off = dev/legacy UUIDs.

# --- Solana / $HEXAR on-chain layer ---------------------------------------------------------
# MAINNET LAUNCH = set these two and you're pointed at your token:
#   NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
#   NEXT_PUBLIC_HEXAR_MINT=<your real mint address>
# (See docs/runbooks/mainnet-launch.md — the mint flip is NOT the same as being safe to custody
#  real funds; multisig treasury + audit + Merkle claims must come first.)
NEXT_PUBLIC_SOLANA_CLUSTER=devnet           # devnet | testnet | mainnet-beta
NEXT_PUBLIC_HEXAR_MINT=                      # blank on mainnet = "not configured" (safe default)
NEXT_PUBLIC_SOLANA_RPC=                      # optional; defaults to the cluster's public RPC (use a PAID RPC in prod)
NEXT_PUBLIC_HEXAR_DECIMALS=9

# --- Token gate (holders-only access to /world) ---
NEXT_PUBLIC_TOKEN_GATE=on                    # "off" disables the gate
NEXT_PUBLIC_TOKEN_GATE_MIN=100               # min $HEXAR balance required to play

# --- Treasury payout script (scripts/payout-war.mjs) — server-side only, NEVER commit real keys ---
# HEXAR_MINT=            # falls back to NEXT_PUBLIC_HEXAR_MINT
# SOLANA_RPC=            # paid RPC for settlement
# TREASURY_SECRET=       # JSON byte array of the treasury keypair (prefer a secret manager)

# --- Legacy EVM contracts (Base Sepolia, superseded by Solana). Unset = mocked. ---
NEXT_PUBLIC_WAR_TOKEN=
NEXT_PUBLIC_STAKING_MANAGER=
NEXT_PUBLIC_SINK_ROUTER=
NEXT_PUBLIC_REWARD_DISTRIBUTOR=
