# WARLANDS on-chain deploy (testnet). Copy to contracts/.env (already gitignored) and fill in.

# Deployer private key — a FRESH throwaway wallet funded with testnet ETH.
# NEVER your main wallet. This key only deploys testnet contracts.
PRIVATE_KEY=

# Target chain RPC. Default = Base Sepolia (public, free). Override for another L2 testnet.
RPC_URL=https://sepolia.base.org

# --- Optional. All default to the deployer address if unset. ---
# OWNER=            # contract owner / admin (use a multisig in prod)
# HOLDER=           # receives the fixed $WAR supply
# TAX_RECEIVER=     # sink-router tax receiver
# GAME_SERVER=      # address the StakingManager trusts for conquest calls
# WAR_SUPPLY=1000000000000000000000000000   # 1,000,000,000 $WAR (18 decimals)
