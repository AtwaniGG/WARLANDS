{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "@/*": ["../src/*"] }
  },
  "include": ["**/*.ts", "../src/sim/**/*.ts", "../src/game/**/*.ts"],
  "exclude": ["**/*.test.ts", "../src/**/*.test.ts"]
}
